algoritmo "primeiro"
// Função :
// Autor :
// Data : 14/12/2025
// Seção de Declarações 
var
ano_nasc: inteiro
ano_atual: inteiro
idade: inteiro
inicio
escreval("Qual ano você nasceu?")
leia(ano_nasc)
escreval("Qual ano estamos?")
leia(ano_atual)
idade <- ano_atual - ano_nasc
escreval ("Sua idade é:", idade)
 




fimalgoritmo
