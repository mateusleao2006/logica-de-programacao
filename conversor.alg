algoritmo "primeiro"
// Função :
// Autor :
// Data : 14/12/2025
// Seção de Declarações 
var

reais: inteiro
dolares: real
inicio
escreval("Qual valor gostaria de converter de Real para dólar?")
leia(reais)

dolares <- reais / 5.40
escreval ("O valor total convertido é de:", dolares)
 




fimalgoritmo
